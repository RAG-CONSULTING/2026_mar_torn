# TORN API key - get from https://www.torn.com/preferences.php#tab=api
TORN_API_KEY=your_torn_api_key_here
TORN_PLAYER_ID=4202918

# Claude backend: CLI mode uses your Max subscription (no API key needed!)
USE_CLAUDE_CLI=true

# Only needed if USE_CLAUDE_CLI=false (uses API credits)
ANTHROPIC_API_KEY=

# Agent configuration
CLAUDE_MODEL=claude-opus-4-6
DRY_RUN=true
AGENT_LOOP_INTERVAL_SECONDS=60
MAX_ACTIONS_PER_LOOP=5

# Safety thresholds
ENERGY_THRESHOLD=25
NERVE_THRESHOLD=5
HAPPY_THRESHOLD=500
MAX_SPEND_PER_ACTION=100000

# Feature toggles
ENABLE_ATTACKS=false
ENABLE_TRAVEL=false
ENABLE_MARKET=false
